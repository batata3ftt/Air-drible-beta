local animationTracks = {}

function loadAnimations()
    local character = player.Character
    if not character then return end
    
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    local animator = humanoid:FindFirstChild("Animator")
    if not animator then return end
    
    animationTracks = {}
    
    local jumpAnim = Instance.new("Animation")
    jumpAnim.AnimationId = JUMP_ANIMATION_ID
    animationTracks.Jump = animator:LoadAnimation(jumpAnim)
    
    local holdAnim = Instance.new("Animation")
    holdAnim.AnimationId = HOLD_ANIMATION_ID
    animationTracks.Hold = animator:LoadAnimation(holdAnim)
    
    local kickAnim = Instance.new("Animation")
    kickAnim.AnimationId = KICK_ANIMATION_ID
    animationTracks.Kick = animator:LoadAnimation(kickAnim)
    
    local fallAnim = Instance.new("Animation")
    fallAnim.AnimationId = FALL_ANIMATION_ID
    animationTracks.Fall = animator:LoadAnimation(fallAnim)
    
    local idleAnim = Instance.new("Animation")
    idleAnim.AnimationId = IDLE_ANIMATION_ID
    animationTracks.Idle = animator:LoadAnimation(idleAnim)
    
    local anim1 = Instance.new("Animation")
    anim1.AnimationId = ANIM1_ANIMATION_ID
    animationTracks.Anim1 = animator:LoadAnimation(anim1)
end

function playShootAnimation()
    task.spawn(function()
        if ANIMATION_DELAY > 1 then
            wait(ANIMATION_DELAY)
        end
        
        if animationTracks.Jump then
            animationTracks.Jump:Play()
            animationTracks.Jump:AdjustSpeed(ANIMATION_SPEED)
        end
        
        if animationTracks.Hold then
            animationTracks.Hold:Play()
            animationTracks.Hold:AdjustSpeed(ANIMATION_SPEED)
        end
        
        task.wait(2)
        if animationTracks.Hold then
            animationTracks.Hold:Stop()
        end
        
        if animationTracks.Kick then
            animationTracks.Kick:Play()
            animationTracks.Kick:AdjustSpeed(ANIMATION_SPEED)
        end
        
        if animationTracks.Jump then
            animationTracks.Jump:Stop()
        end
        
        if animationTracks.Fall then
            animationTracks.Fall:Play()
            animationTracks.Fall:AdjustSpeed(ANIMATION_SPEED)
        end
        
        if animationTracks.Idle then
            animationTracks.Idle:Play()
            animationTracks.Idle:AdjustSpeed(ANIMATION_SPEED)
        end
        
        task.wait(3)
        if animationTracks.Kick then
            animationTracks.Kick:Stop()
        end
        
        if animationTracks.Fall then
            animationTracks.Fall:Stop()
        end
        
        if animationTracks.Anim1 then
            animationTracks.Anim1:Play()
            animationTracks.Anim1:AdjustSpeed(ANIMATION_SPEED)
        end
    end)
end

